---
// Auth Modal Component
---

<div id="authModal" class="fixed inset-0 bg-black bg-opacity-70 hidden items-center justify-center z-50" style="display: none;">
	<div class="bg-white dark:bg-black rounded-lg p-8 max-w-md w-full mx-4 relative border border-gray-200 dark:border-gray-800">
		<button
			id="closeModal"
			class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
			aria-label="Close"
		>
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>

		<!-- Tab Headers -->
		<div class="flex mb-8 gap-8 border-b border-gray-200 dark:border-gray-800">
			<button
				id="signInTab"
				class="pb-2 text-sm font-light border-b-2 border-gray-900 dark:border-gray-100 text-gray-900 dark:text-gray-100"
			>
				sign in
			</button>
			<button
				id="signUpTab"
				class="pb-2 text-sm font-light border-b-2 border-transparent text-gray-400 dark:text-gray-600 hover:text-gray-600 dark:hover:text-gray-400"
			>
				sign up
			</button>
		</div>

		<!-- Google Sign In -->
		<button
			id="googleSignIn"
			class="w-full py-3 px-6 mb-6 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 border border-gray-300 dark:border-gray-700 hover:border-gray-900 dark:hover:border-gray-100 rounded transition-colors font-light text-sm flex items-center justify-center gap-3"
		>
			<svg class="w-5 h-5" viewBox="0 0 24 24">
				<path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
				<path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
				<path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
				<path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
			</svg>
			continue with google
		</button>

		<!-- Divider -->
		<div class="relative mb-6">
			<div class="absolute inset-0 flex items-center">
				<div class="w-full border-t border-gray-300 dark:border-gray-700"></div>
			</div>
			<div class="relative flex justify-center text-sm">
				<span class="px-4 bg-white dark:bg-black text-gray-400 dark:text-gray-600 font-light">or</span>
			</div>
		</div>

		<!-- Sign In Form -->
		<form id="signInForm" class="space-y-6">
			<div>
				<label for="signInEmail" class="block text-sm font-light text-gray-600 dark:text-gray-400 mb-2">
					email
				</label>
				<input
					type="email"
					id="signInEmail"
					name="email"
					required
					autocomplete="email"
					class="w-full px-0 py-2 border-0 border-b border-gray-300 dark:border-gray-700 focus:outline-none focus:border-gray-900 dark:focus:border-gray-100 bg-transparent text-gray-900 dark:text-gray-100 font-light placeholder-gray-400 dark:placeholder-gray-600"
					placeholder="your@email.com"
				/>
			</div>
			<div>
				<label for="signInPassword" class="block text-sm font-light text-gray-600 dark:text-gray-400 mb-2">
					password
				</label>
				<input
					type="password"
					id="signInPassword"
					name="password"
					required
					autocomplete="current-password"
					class="w-full px-0 py-2 border-0 border-b border-gray-300 dark:border-gray-700 focus:outline-none focus:border-gray-900 dark:focus:border-gray-100 bg-transparent text-gray-900 dark:text-gray-100 font-light placeholder-gray-400 dark:placeholder-gray-600"
					placeholder="••••••••"
				/>
			</div>
			<div id="signInError" class="text-red-600 dark:text-red-400 text-sm font-light hidden"></div>
			<button
				type="submit"
				class="w-full py-3 px-6 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 border border-gray-300 dark:border-gray-700 hover:border-gray-900 dark:hover:border-gray-100 rounded transition-colors font-light text-sm"
			>
				sign in
			</button>
		</form>

		<!-- Sign Up Form -->
		<form id="signUpForm" class="space-y-6 hidden">
			<div>
				<label for="signUpName" class="block text-sm font-light text-gray-600 dark:text-gray-400 mb-2">
					name
				</label>
				<input
					type="text"
					id="signUpName"
					name="name"
					required
					autocomplete="name"
					class="w-full px-0 py-2 border-0 border-b border-gray-300 dark:border-gray-700 focus:outline-none focus:border-gray-900 dark:focus:border-gray-100 bg-transparent text-gray-900 dark:text-gray-100 font-light placeholder-gray-400 dark:placeholder-gray-600"
					placeholder="your name"
				/>
			</div>
			<div>
				<label for="signUpEmail" class="block text-sm font-light text-gray-600 dark:text-gray-400 mb-2">
					email
				</label>
				<input
					type="email"
					id="signUpEmail"
					name="email"
					required
					autocomplete="email"
					class="w-full px-0 py-2 border-0 border-b border-gray-300 dark:border-gray-700 focus:outline-none focus:border-gray-900 dark:focus:border-gray-100 bg-transparent text-gray-900 dark:text-gray-100 font-light placeholder-gray-400 dark:placeholder-gray-600"
					placeholder="your@email.com"
				/>
			</div>
			<div>
				<label for="signUpPassword" class="block text-sm font-light text-gray-600 dark:text-gray-400 mb-2">
					password
				</label>
				<input
					type="password"
					id="signUpPassword"
					name="password"
					required
					minlength="8"
					autocomplete="new-password"
					class="w-full px-0 py-2 border-0 border-b border-gray-300 dark:border-gray-700 focus:outline-none focus:border-gray-900 dark:focus:border-gray-100 bg-transparent text-gray-900 dark:text-gray-100 font-light placeholder-gray-400 dark:placeholder-gray-600"
					placeholder="••••••••"
				/>
				<p class="text-xs text-gray-400 dark:text-gray-600 mt-1 font-light">minimum 8 characters</p>
			</div>
			<div id="signUpError" class="text-red-600 dark:text-red-400 text-sm font-light hidden"></div>
			<button
				type="submit"
				class="w-full py-3 px-6 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 border border-gray-300 dark:border-gray-700 hover:border-gray-900 dark:hover:border-gray-100 rounded transition-colors font-light text-sm"
			>
				create account
			</button>
		</form>
	</div>
</div>

<script>
	import { authClient } from '../lib/auth-client';

	const modal = document.getElementById('authModal')!;
	const closeBtn = document.getElementById('closeModal')!;
	const signInTab = document.getElementById('signInTab')!;
	const signUpTab = document.getElementById('signUpTab')!;
	const signInForm = document.getElementById('signInForm') as HTMLFormElement;
	const signUpForm = document.getElementById('signUpForm') as HTMLFormElement;
	const signInError = document.getElementById('signInError')!;
	const signUpError = document.getElementById('signUpError')!;
	const googleSignInBtn = document.getElementById('googleSignIn')!;

	// Make modal accessible globally
	(window as any).openAuthModal = () => {
		modal.style.display = 'flex';
		// Focus first input
		setTimeout(() => {
			const firstInput = signInForm.querySelector('input');
			firstInput?.focus();
		}, 100);
	};

	(window as any).closeAuthModal = () => {
		modal.style.display = 'none';
		signInError.classList.add('hidden');
		signUpError.classList.add('hidden');
		signInForm.reset();
		signUpForm.reset();
	};

	closeBtn.addEventListener('click', () => (window as any).closeAuthModal());
	modal.addEventListener('click', (e) => {
		if (e.target === modal) (window as any).closeAuthModal();
	});

	// Google Sign In
	googleSignInBtn.addEventListener('click', async () => {
		try {
			const result = await authClient.signIn.social({
				provider: 'google',
				callbackURL: window.location.origin,
			});
		} catch (error) {
			console.error('Google sign-in error:', error);
		}
	});

	// Tab switching
	signInTab.addEventListener('click', () => {
		signInTab.classList.add('border-gray-900', 'dark:border-gray-100', 'text-gray-900', 'dark:text-gray-100');
		signInTab.classList.remove('border-transparent', 'text-gray-400', 'dark:text-gray-600');
		signUpTab.classList.remove('border-gray-900', 'dark:border-gray-100', 'text-gray-900', 'dark:text-gray-100');
		signUpTab.classList.add('border-transparent', 'text-gray-400', 'dark:text-gray-600');
		signInForm.classList.remove('hidden');
		signUpForm.classList.add('hidden');
		signInError.classList.add('hidden');
		signUpError.classList.add('hidden');
		// Focus first input
		setTimeout(() => {
			const firstInput = signInForm.querySelector('input');
			firstInput?.focus();
		}, 100);
	});

	signUpTab.addEventListener('click', () => {
		signUpTab.classList.add('border-gray-900', 'dark:border-gray-100', 'text-gray-900', 'dark:text-gray-100');
		signUpTab.classList.remove('border-transparent', 'text-gray-400', 'dark:text-gray-600');
		signInTab.classList.remove('border-gray-900', 'dark:border-gray-100', 'text-gray-900', 'dark:text-gray-100');
		signInTab.classList.add('border-transparent', 'text-gray-400', 'dark:text-gray-600');
		signUpForm.classList.remove('hidden');
		signInForm.classList.add('hidden');
		signInError.classList.add('hidden');
		signUpError.classList.add('hidden');
		// Focus first input
		setTimeout(() => {
			const firstInput = signUpForm.querySelector('input');
			firstInput?.focus();
		}, 100);
	});

	// Sign In
	signInForm.addEventListener('submit', async (e) => {
		e.preventDefault();
		signInError.classList.add('hidden');

		const formData = new FormData(signInForm);
		const email = formData.get('email') as string;
		const password = formData.get('password') as string;

		try {
			const result = await authClient.signIn.email({
				email,
				password,
			});

			if (result.error) {
				signInError.textContent = result.error.message || 'Failed to sign in';
				signInError.classList.remove('hidden');
			} else {
				(window as any).closeAuthModal();
				window.location.reload();
			}
		} catch (error: any) {
			signInError.textContent = error.message || 'An error occurred';
			signInError.classList.remove('hidden');
		}
	});

	// Sign Up
	signUpForm.addEventListener('submit', async (e) => {
		e.preventDefault();
		signUpError.classList.add('hidden');

		const formData = new FormData(signUpForm);
		const name = formData.get('name') as string;
		const email = formData.get('email') as string;
		const password = formData.get('password') as string;

		try {
			const result = await authClient.signUp.email({
				email,
				password,
				name,
			});

			if (result.error) {
				signUpError.textContent = result.error.message || 'Failed to create account';
				signUpError.classList.remove('hidden');
			} else {
				(window as any).closeAuthModal();
				window.location.reload();
			}
		} catch (error: any) {
			signUpError.textContent = error.message || 'An error occurred';
			signUpError.classList.remove('hidden');
		}
	});
</script>
