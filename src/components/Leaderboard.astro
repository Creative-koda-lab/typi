---
// Leaderboard Component
interface LeaderboardEntry {
	rank: number;
	name: string;
	wpm: number;
	userId: string;
}
---

<div class="w-full max-w-2xl mx-auto mt-16">
	<h2 class="text-2xl font-light text-gray-800 dark:text-gray-100 mb-6 text-center">
		leaderboard
	</h2>

	<div class="border border-gray-200 dark:border-gray-800 rounded-lg overflow-hidden">
		<!-- Header -->
		<div class="grid grid-cols-12 gap-4 px-6 py-3 bg-gray-50 dark:bg-gray-900 text-xs font-light text-gray-500 dark:text-gray-500 uppercase">
			<div class="col-span-2">rank</div>
			<div class="col-span-7">player</div>
			<div class="col-span-3 text-right">wpm</div>
		</div>

		<!-- Leaderboard Entries -->
		<div id="leaderboardEntries" class="divide-y divide-gray-200 dark:divide-gray-800">
			<!-- Loading state -->
			<div class="px-6 py-4 text-center text-sm text-gray-400 dark:text-gray-600">
				loading...
			</div>
		</div>
	</div>
</div>

<script>
	async function loadLeaderboard() {
		try {
			const response = await fetch('/api/leaderboard');
			const data = await response.json();

			const entriesContainer = document.getElementById('leaderboardEntries');
			if (!entriesContainer) return;

			if (data.leaderboard && data.leaderboard.length > 0) {
				entriesContainer.innerHTML = data.leaderboard.map((entry: any, index: number) => `
					<div class="grid grid-cols-12 gap-4 px-6 py-4 hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors">
						<div class="col-span-2 flex items-center">
							<span class="text-sm font-light ${index < 3 ? 'text-gray-900 dark:text-gray-100' : 'text-gray-600 dark:text-gray-400'}">
								${index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : index + 1}
							</span>
						</div>
						<div class="col-span-7 flex items-center">
							<span class="text-sm font-light text-gray-800 dark:text-gray-200 truncate">
								${entry.name || 'anonymous'}
							</span>
						</div>
						<div class="col-span-3 flex items-center justify-end">
							<span class="text-sm font-light text-gray-900 dark:text-gray-100">
								${entry.wpm}
							</span>
						</div>
					</div>
				`).join('');
			} else {
				entriesContainer.innerHTML = `
					<div class="px-6 py-4 text-center text-sm text-gray-400 dark:text-gray-600">
						no scores yet
					</div>
				`;
			}
		} catch (error) {
			console.error('Failed to load leaderboard:', error);
			const entriesContainer = document.getElementById('leaderboardEntries');
			if (entriesContainer) {
				entriesContainer.innerHTML = `
					<div class="px-6 py-4 text-center text-sm text-red-600 dark:text-red-400">
						failed to load leaderboard
					</div>
				`;
			}
		}
	}

	// Load leaderboard on page load
	loadLeaderboard();

	// Reload leaderboard when user completes a test
	window.addEventListener('testCompleted', () => {
		setTimeout(() => loadLeaderboard(), 500);
	});
</script>
